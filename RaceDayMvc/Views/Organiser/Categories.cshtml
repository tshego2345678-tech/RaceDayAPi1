@model EventDetailsVm
@{ ViewData["Title"] = "Categories"; }
<h2 class="page-title">Categories &mdash; @Model.Event.Name</h2>
<div class="row g-4">
<div class="col-lg-7"><div class="card"><div class="card-header">Current categories</div>
<div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Name</th><th>Distance</th><th>Fee</th><th>Limit</th><th></th></tr></thead><tbody>
@foreach (var c in Model.Categories)
{
    <tr><td>@c.Name</td><td>@c.DistanceKm km</td><td>R @c.EntryFee.ToString("0.00")</td><td>@c.MaxParticipants</td>
    <td class="text-end"><form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Remove this category?');">
        <input type="hidden" name="eventId" value="@Model.Event.Id" /><input type="hidden" name="categoryId" value="@c.Id" />
        <button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr>
}
@if (!Model.Categories.Any()) { <tr><td colspan="5" class="text-muted text-center py-3">No categories yet.</td></tr> }
</tbody></table></div></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header">Add category</div><div class="card-body">
<form asp-action="AddCategory" method="post">
    <input type="hidden" name="eventId" value="@Model.Event.Id" />
    <div class="mb-3"><label class="form-label">Name</label><input name="name" class="form-control" placeholder="e.g. 10 km, Under 20, Masters 40+" required /></div>
    <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Distance (km)</label><input name="distanceKm" type="number" step="0.1" min="0.1" class="form-control" required /></div>
        <div class="col-6 mb-3"><label class="form-label">Entry fee (R)</label><input name="entryFee" type="number" step="0.01" min="0" class="form-control" required /></div>
    </div>
    <div class="mb-3"><label class="form-label">Max participants</label><input name="maxParticipants" type="number" min="1" class="form-control" required /></div>
    <button class="btn rd-btn">Add</button>
</form></div></div></div>
</div>
<a asp-action="Events" class="btn btn-link mt-3">&larr; Back to events</a>
