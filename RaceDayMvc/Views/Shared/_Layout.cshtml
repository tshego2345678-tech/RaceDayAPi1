@{
    var role = Context.Session.GetString("Role");
    var name = Context.Session.GetString("Name");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark rd-nav">
    <div class="container">
        <a class="navbar-brand rd-brand" href="/">RACE<span>DAY</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                @if (role == "Organiser")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">My Events</a></li>
                }
                else if (role == "Participant")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Upcoming Events</a></li>
                }
            </ul>
            <ul class="navbar-nav align-items-lg-center">
                @if (role != null)
                {
                    <li class="nav-item text-light me-lg-3 small">@name <span class="badge rd-role">@role</span></li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">Log out</button></form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-sm rd-btn ms-lg-2" asp-controller="Account" asp-action="Register">Sign up</a></li>
                }
            </ul>
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }
    @RenderBody()
</main>
<footer class="rd-footer text-center py-3">&copy; @DateTime.Now.Year RaceDay &middot; Run. Ride. Walk. Finish.</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
