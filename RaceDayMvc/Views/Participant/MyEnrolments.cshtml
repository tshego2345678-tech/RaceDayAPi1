@model List<EnrolmentDto>
@{ ViewData["Title"] = "My Enrolments"; }
<h2 class="page-title">My enrolments</h2>
@if (!Model.Any()) { <div class="alert alert-secondary">You haven't enrolled for any events yet. <a asp-controller="Home" asp-action="Index">Browse events</a></div> }
else {
<div class="table-responsive"><table class="table table-striped align-middle bg-white">
<thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th></th></tr></thead>
<tbody>
@foreach (var e in Model) { <tr><td><a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td><partial name="_Status" model="e.Status" /></td><td class="text-end">@if (e.EventDate >= DateTime.Today) {<form asp-action="CancelEnrolment" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Cancel this enrolment?');"><button class="btn btn-sm btn-outline-danger">Cancel</button></form>}</td></tr> }
</tbody></table></div> }
